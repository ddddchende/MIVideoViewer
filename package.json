{
  "name": "mi-video-viewer",
  "version": "1.1.0",
  "description": "小米摄像头录像查看器",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mivideoviewer.app",
    "productName": "MI Video Viewer",
    "asar": true,
    "afterPack": "build/afterPack.js",
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "src/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "zip"
      ],
      "signExecutable": false,
      "artifactName": "MI-Video-Viewer-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MI-Video-Viewer-Portable-${version}.${ext}"
    },
    "nsis": {
      "differentialPackage": false
    }
  }
}
